# Copia este archivo a `.env` y rellena los valores. NUNCA commitear `.env`.
#
# Reglas:
#  - Sin prefijo VITE_: Vite inlinea cualquier variable VITE_* en el bundle del
#    CLIENTE, asi que un token con ese prefijo queda publico. El servidor solo
#    lee las variables sin prefijo listadas aqui.
#  - Los IDs de base de datos de Notion no son secretos y van con valor real.

# --- Notion (requerido por /api/tasks) ---------------------------------------
# Token de integracion interna de Notion (secret).
NOTION_TOKEN=
# Base de Tareas que alimenta GET /api/tasks (requerido).
NOTION_TAREAS_DATABASE_ID=
# Bases con fallback en server/config.js si se dejan vacias.
NOTION_PROYECTOS_DATABASE_ID=2e8b1371-59c9-80c4-9ee8-f4ecebb90ee2
NOTION_SNAPSHOTS_DATABASE_ID=2ebb1371-59c9-806a-86a6-c1d61d3265f0
# Otras bases usadas por scripts/herramientas fuera de la app web.
NOTION_DATABASE_ID=
NOTION_TICKETS_DATABASE_ID=

# --- Identidad del usuario en Notion -----------------------------------------
PERSONA_NOMBRE=
PERSONA_ID=

# --- Slack (definido pero sin consumidores en la app web) --------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# --- Varios ------------------------------------------------------------------
# PIN para la vista de costos (secret).
COSTOS_PIN=
# Ruta del archivo de base de datos local.
DB_PATH=

# --- Servidor de produccion (server/index.js) -------------------------------
# Puerto y host del servidor standalone. Opcionales.
PORT=4173
HOST=0.0.0.0
